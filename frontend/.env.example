# Local development needs none of this (./run.sh). For 0G Galileo, copy to .env.local and fill in:
NEXT_PUBLIC_CHAIN=galileo
# optional: a different Galileo RPC (default https://evmrpc-testnet.0g.ai)
# NEXT_PUBLIC_RPC_URL=
# where this website's server forwards /exec/* and /storage/* (both services must use Galileo too)
EXECUTION_URL=http://127.0.0.1:8000
STORAGE_URL=http://127.0.0.1:8020
# NEXT_PUBLIC_CHAIN=sepolia also works (with NEXT_PUBLIC_RPC_URL set to a Sepolia endpoint)
