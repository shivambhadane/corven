</noscript><!-- ============================================================
     1. AUTO-ROTATING TABS  —  desktop only
     ============================================================ -->
<script>
window.Webflow = window.Webflow || [];
window.Webflow.push(function () {
  var ROTATE_MS = 4000;
  var mq = window.matchMedia('(min-width: 992px)');
  var tabTimeout = null;
  var running = false;

  // No burger on desktop normally, but keep the check just in case.
  function isNavOpen() {
    return $('.menu-btn.w--open, .w-nav-button.w--open, .menu-button.w--open').length > 0;
  }

  function tabLoop() {
    tabTimeout = setTimeout(function () {
      if (isNavOpen()) { tabLoop(); return; }

      var $next = $('.tabs-menu').children('.w--current:first').next();
      var $target = $next.length ? $next : $('.tab-link:first');

      // Strip the href so the click does not navigate.
      $target.removeAttr('href').click();
    }, ROTATE_MS);
  }

  function start() {
    if (running) { return; }
    running = true;
    // Namespaced so a restart does not stack duplicate handlers.
    $(document).on('click.autotabs', '.tab-link', function () {
      clearTimeout(tabTimeout);
      tabLoop();
    });
    tabLoop();
  }

  function stop() {
    running = false;
    clearTimeout(tabTimeout);
    tabTimeout = null;
    $(document).off('.autotabs');
  }

  function update() {
    if (mq.matches) { start(); } else { stop(); }
  }

  update();
  if (mq.addEventListener) { mq.addEventListener('change', update); }
  else { mq.addListener(update); }              // older browsers
});
</script>
<!-- ============================================================
     2. PAGE UI
     All of these touch Webflow components, so they run after the
     interaction engine has bound handlers, not on DOMContentLoaded.
     ============================================================ -->
<script>
window.Webflow = window.Webflow || [];
window.Webflow.push(function () {

  // MemberScript #79 — hover acts as a click on tab links
  document.querySelectorAll('[ms-code-onhover="click"]').forEach(function (el) {
    el.addEventListener('mouseenter', function () { el.click(); });
  });

  // Open the first stat block on tablet and below
  if (window.matchMedia('(max-width: 991px)').matches) {
    var firstStat = document.querySelector('.stats-block');
    if (firstStat) { firstStat.click(); }
  }

  // Stop Enter submitting these forms
  document.querySelectorAll('form[data-disable-enter="true"]').forEach(function (form) {
    form.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && e.target.tagName !== 'TEXTAREA') {
        e.preventDefault();
      }
    });
  });
});
</script>
<!-- ============================================================
     3. CLICK-TO-PLAY YOUTUBE  —  drives every .yt-facade
     ============================================================ -->
<script>
(function () {
  // Switch to 'www.youtube-nocookie.com' for no tracking cookies,
  // at the cost of less reliable click-to-play.
  var HOST = 'www.youtube.com';

  var THUMB = 'https://i.ytimg.com/vi/';
  var OPTS = '?autoplay=1&enablejsapi=1&rel=0&controls=1&playsinline=1';
  var ALLOW = 'accelerometer; autoplay; encrypted-media; ' +
              'gyroscope; picture-in-picture';
  var PLAY = '{"event":"command","func":"playVideo","args":""}';
  var LISTEN = '{"event":"listening","id":1,"channel":"widget"}';

  function idOf(box) {
    var el = box.querySelector('.yt-facade__id');
    var raw = box.getAttribute('data-video-id');
    if (!raw) { raw = box.getAttribute('video-id'); }
    if (!raw) { raw = box.getAttribute('data-yt-id'); }
    if (!raw && el) { raw = el.textContent; }
    if (!raw) { return ''; }
    raw = raw.trim();
    var re = /(?:v=|youtu\.be\/|embed\/|shorts\/)([A-Za-z0-9_-]{6,})/;
    var m = raw.match(re);
    if (m) { return m[1]; }
    return raw;
  }

  function paint(box, id) {
    if (box.dataset.painted) { return; }
    box.dataset.painted = '1';
    if (box.hasAttribute('data-keep-thumb')) { return; }
    var img = box.querySelector('.yt-facade__thumb');
    if (!img) { return; }
    img.src = THUMB + id + '/maxresdefault.jpg';
    img.srcset = THUMB + id + '/mqdefault.jpg 320w, ' +
                 THUMB + id + '/maxresdefault.jpg 1280w';
    img.sizes = '(max-width: 767px) 100vw, 800px';
    img.addEventListener('error', function () {
      img.removeAttribute('srcset');
      img.src = THUMB + id + '/hqdefault.jpg';
    }, { once: true });
  }

  function nudge(f) {
    var tries = 0;
    var timer = null;

    function stop() {
      if (timer) { clearInterval(timer); timer = null; }
      window.removeEventListener('message', onMessage);
    }

    // The player talks back once it is running. As soon as it does,
    // stop asking it to play, or a quick pause gets overridden.
    function onMessage(e) {
      if (e.source !== f.contentWindow) { return; }
      stop();
    }

    window.addEventListener('message', onMessage);

    timer = setInterval(function () {
      if (f.contentWindow) {
        f.contentWindow.postMessage(LISTEN, '*');
        f.contentWindow.postMessage(PLAY, '*');
      }
      tries = tries + 1;
      if (tries > 3) { stop(); }
    }, 400);
  }

  function play(box, id) {
    if (box.dataset.loaded) { return; }
    box.dataset.loaded = '1';
    var title = box.getAttribute('data-yt-title') || 'Video';
    var f = document.createElement('iframe');
    f.allow = ALLOW;
    f.allowFullscreen = true;
    f.title = title;
    f.addEventListener('load', function () { nudge(f); });
    f.src = 'https://' + HOST + '/embed/' + id + OPTS;
    box.innerHTML = '';
    box.appendChild(f);
  }

  function watch(box, id) {
    if (!window.IntersectionObserver) {
      paint(box, id);
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      var i;
      for (i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting) {
          paint(box, id);
          io.disconnect();
        }
      }
    }, { rootMargin: '400px' });
    io.observe(box);
  }

  function wire(box) {
    if (box.dataset.wired) { return; }
    var id = idOf(box);
    if (!id) { return; }
    box.dataset.wired = '1';
    watch(box, id);
    box.addEventListener('click', function () {
      play(box, id);
    });
    box.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        play(box, id);
      }
    });
  }

  function init() {
    var list = document.querySelectorAll('.yt-facade');
    var i;
    for (i = 0; i < list.length; i++) { wire(list[i]); }
  }

  if (window.Webflow) {
    window.Webflow.push(init);
  } else if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script><script src="assets/js/hs_trackcode_48695808-1.0.6.js" type="text/javascript"></script><script src="assets/js/form-124.js" type="text/javascript"></script>
