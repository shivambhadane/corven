<style>
  /* Stop PolySans rendering heavy on macOS */
  body {
    -moz-osx-font-smoothing: grayscale;
    -webkit-font-smoothing: antialiased;
  }

  /* Background pixels: still image by default. The footer script adds
     .has-video once the video actually plays, which covers iOS Low
     Power Mode and any browser that blocks autoplay. */
  .bg-pic-pixels            { display: block !important; }
  .bg-video-pixels          { display: none  !important; }
  .has-video .bg-video-pixels { display: block !important; }
  .has-video .bg-pic-pixels   { display: none  !important; }

  /* Click-to-play video: the iframe is created by JS, so it cannot
     be styled in the Designer. */
  .yt-facade iframe {
    position: absolute; inset: 0;
    width: 100%; height: 100%; border: 0;
  }

  .nav-text-wrap  { overflow: hidden; }
  .preloader-wrap { display: block; }
</style>
<!-- ============================================================
     3. INTERACTION FAILSAFE  —  must run early
     Webflow hides every element with a Page Load initial state until
     it stamps .w-mod-ix3. If the engine is slow or fails, that content
     never appears. This stamps the class itself after 2s.
     Fires an ix2_failsafe dataLayer event so the rate is measurable.
     ============================================================ -->
<script>
(function () {
  var HTML = document.documentElement;
  var FAILSAFE_MS = 2000;

  function reveal(reason) {
    if (HTML.className.indexOf('w-mod-ix3') !== -1) { return; }
    HTML.className += ' w-mod-ix3';
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'ix2_failsafe', reason: reason });
  }

  setTimeout(function () { reveal('timeout'); }, FAILSAFE_MS);

  window.addEventListener('pageshow', function (e) {
    if (e.persisted) { reveal('bfcache'); }
  });
})();
</script>
<!-- ============================================================
     4. ANALYTICS  —  production only, never on *.webflow.io
     NOTE: GA4 and Google Ads may also be configured inside the GTM
     container. If so, this block is a duplicate: gtag/js is currently
     fetched four times and conversions are likely double-counted.
     Confirm with whoever owns GTM, then delete one of the two.
     ============================================================ -->
<script>
  // Defined on every environment so nothing throws when it calls gtag().
  window.dataLayer = window.dataLayer || [];
  window.gtag = function () { window.dataLayer.push(arguments); };

  (function () {
    if (location.hostname.endsWith('.webflow.io')) { return; }

    // Google Tag Manager
    (function (w, d, s, l, i) {
      w[l] = w[l] || [];
      w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      var f = d.getElementsByTagName(s)[0];
      var j = d.createElement(s);
      var dl = l != 'dataLayer' ? '&l=' + l : '';
      j.async = true;
      j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
      f.parentNode.insertBefore(j, f);
    })(window, document, 'script', 'dataLayer', 'GTM-NDPRKLX3');

    // Google tag, injected rather than hardcoded so staging never
    // downloads 572 KB it will not use.
    var g = document.createElement('script');
    g.async = true;
    g.src = 'https://www.googletagmanager.com/gtag/js?id=G-22T2YVQMMG';
    document.head.appendChild(g);

    gtag('js', new Date());
    gtag('config', 'G-22T2YVQMMG');      // Google Analytics 4
    gtag('config', 'AW-11239851886');    // Google Ads
  })();
</script>
