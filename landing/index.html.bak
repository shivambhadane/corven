<!-- ============================================================
     2. BACKGROUND VIDEO
     Webflow autoplays it natively. This only detects whether playback
     actually started and flips the CSS from still image to video.
     Do NOT defer the video: it is the LCP element, so loading it late
     makes LCP later, not better.
     ============================================================ -->
<script>
(function () {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { return; }

  var v = document.querySelector('.bg-video-pixels video');
  if (!v) { return; }

  v.muted = true;
  v.setAttribute('muted', '');
  v.setAttribute('playsinline', '');

  v.addEventListener('playing', function () {
    document.documentElement.classList.add('has-video');
  }, { once: true });

  var p;
  try { p = v.play(); } catch (e) { return; }   // blocked: the still stays
  if (p && p.catch) { p.catch(function () {}); }
})();
</script>
