     4. FORMS & ATTRIBUTION
     ============================================================ -->
<!-- First-touch UTM capture, then fill hidden form fields -->
<script>
(function () {
  var UTM_PARAMS = ['utm_source', 'utm_medium', 'utm_campaign',
                    'utm_content', 'utm_term'];
  var COOKIE_PREFIX = 't9_';
  var COOKIE_DAYS = 30;

  function getURLParam(name) {
    return new URL(window.location.href).searchParams.get(name) || '';
  }

  function setCookie(name, value, days) {
    var d = new Date();
    d.setDate(d.getDate() + days);
    document.cookie = name + '=' + encodeURIComponent(value) +
      '; expires=' + d.toUTCString() + '; path=/; SameSite=Lax';
  }

  function getCookie(name) {
    var m = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]+)'));
    return m ? decodeURIComponent(m[1]) : '';
  }

  // First touch wins: only store a value if nothing is stored yet.
  UTM_PARAMS.forEach(function (param) {
    var value = getURLParam(param);
    var cookie = COOKIE_PREFIX + param;
    if (value && !getCookie(cookie)) { setCookie(cookie, value, COOKIE_DAYS); }
  });

  function fillHiddenFields() {
    UTM_PARAMS.forEach(function (param) {
      var value = getCookie(COOKIE_PREFIX + param) || getURLParam(param);
      if (!value) { return; }
      document.querySelectorAll('input[name="' + param + '"]')
        .forEach(function (input) { input.value = value; });
    });

    var hutk = document.cookie.match(/hubspotutk=([^;]+)/);
    if (!hutk) { return; }
    document.querySelectorAll('input[name="hutk"], input[name="Hutk"]')
      .forEach(function (input) { input.value = hutk[1]; });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', fillHiddenFields);
  } else {
    fillHiddenFields();
  }
})();
</script>
<!-- Mirror the Get a Call form to the outbound webhook -->
<script>
window.Webflow = window.Webflow || [];
window.Webflow.push(function () {
  var form = document.getElementById('wf-form-Get-a-Call-Form');
  if (!form) { return; }

  form.addEventListener('submit', function () {
    var fd = new FormData(form);
    function get(k) { return fd.get(k) || fd.get(k.replace(' ', '-')) || ''; }

    fetch('https://n7bfcway1k.execute-api.us-east-1.amazonaws.com/default/T9-website-outbound', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        triggerType: 'form_submission',
        payload: {
          name: 'Get a Call Form',
          siteId: '684a82e3294991569082d379',
          formId: '697335f8fa73126bdfe1a6e2',
          submittedAt: new Date().toISOString(),
          id: 'wf-' + Date.now(),
          data: {
            'First Name': get('First Name'),
            'Last Name': get('Last Name'),
            'Phone': get('Phone'),
            'Email': get('Email')
          }
        }
      })
    }).catch(function () {});
  }, true);
});
</script>
