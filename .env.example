# CORVEN environment. Copy to .env (git-ignored) and fill in locally. Never commit real values.

# --- Database / API ---
DATABASE_URL=
CORVEN_DEV_AUTH=
AGENT_TOKEN_SECRET=

# --- Ethereum Sepolia (evidence anchoring) ---
ETHEREUM_SEPOLIA_RPC_URL=
ETHEREUM_CHAIN_ID=11155111
# Dedicated testnet-only anchor signer. SECRET.
ETHEREUM_SIGNER_PRIVATE_KEY=
# Empty until an approved deployment.
EVIDENCE_ANCHOR_CONTRACT_ADDRESS=

# --- Arkiv (Rabdi DB-Chain public testnet) ---
ARKIV_ENABLED=true
ARKIV_NETWORK=rabdi
ARKIV_CHAIN_ID=7794095
# Optional. If set it must be exactly this endpoint; the key is NOT put in the URL.
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
# Arkiv Hub access key for Rabdi. SECRET. Sent only in the X-API-KEY header.
ARKIV_ACCESS_KEY=
# Wallet that creates entities and pays tGLM. SECRET. Without it Arkiv is read-only.
ARKIV_SIGNER_PRIVATE_KEY=
# Development only: allow the key-less, heavily rate-limited public endpoint.
ARKIV_ALLOW_PUBLIC_ENDPOINT=false
